<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Media access only. Telepic requests the modern, version-appropriate photo/video
      permissions, plus ACCESS_MEDIA_LOCATION below, and never requests *device* location
      (no fine/coarse location permission) or unrelated permissions.
    -->
    <!-- Android 13+ (API 33) granular media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+ (API 34) partial "selected photos" access -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Android 12 and below (API <= 32) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
      Android 10+ (API 29): reading the GPS coordinates embedded in the user's own photos requires
      this runtime permission. Since Android 10 the platform redacts location from the stream a
      MediaStore URI opens unless the app both holds ACCESS_MEDIA_LOCATION and asks for the original
      via MediaStore.setRequireOriginal. It grants no device location and no network access — it only
      un-redacts the EXIF the user's files already carry, which Telepic reads locally for the
      on-device map and never uploads.
    -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!--
      Android 9 and below (API <= 28): publishing a restored original into the public gallery goes
      through the legacy MediaStore, which needs write access. API 29+ uses scoped storage
      (RELATIVE_PATH + IS_PENDING) and needs no permission, so this is capped at 29 and is never
      requested on modern devices. Declared because minSdk is 26.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
      The video player's right-half drag changes the media stream's level programmatically; Android
      gates stream-volume changes on this normal (install-time, non-runtime) permission.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Phase 6 backup engine: WorkManager drives long-running uploads. The foreground service is
      WorkManager's own (no custom service class), gated on network, and only used while actively
      uploading. Data-sync is the closest correct type for a backup upload.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Phase 10 map: tiles are fetched from an OpenStreetMap-compatible provider over the network.
      Telepic does NOT request any *device* location permission — the map has no notion of where the
      phone is. Photo locations come only from the GPS data already embedded in the media files,
      which is read on-device (the ACCESS_MEDIA_LOCATION declaration above exists precisely so that
      read is not redacted on API 29+), and no coordinates or EXIF are ever uploaded.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      allowBackup=false: Telepic holds a live Telegram session (TDLib database + keystore-wrapped
      key) and a queue that references every backed-up file. There is no backup-set configuration
      that makes an ADB/cloud transfer of this app's data provably safe, so the app opts out
      entirely; settings and the queue rebuild from first launch, and the TDLib session already
      lives under noBackupFilesDir. (Formerly true with XML exclusion rules — retired here.)
    -->
    <!--
      Predictive back: opt into the OnBackInvokedCallback pipeline on Android 13+. MainActivity has no
      onBackPressed override and the screens use Compose BackHandler, which routes through it, so back
      behaviour is preserved while the system gains the predictive-back animation.
    -->
    <application
        android:name=".TelepicApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Telepic">

        <!-- WorkManager is initialized on-demand via TelepicApplication (Configuration.Provider),
             which lets the backup worker receive the app container. Disable the default startup
             initializer so it is not created before the container exists. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          WorkManager's foreground service is declared by the library WITHOUT a foregroundServiceType.
          Since targetSdk 34 a foreground service started as type "none" is rejected with
          InvalidForegroundServiceTypeException, so a backup run crashed the app on Android 14+. The
          worker now tags its notification dataSync; this merge is what makes that type legal — it must
          match FOREGROUND_SERVICE_TYPE_DATA_SYNC in BackupWorker and the permission above.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Bounded local diagnostics: the app shares its own log only through an explicit user
             action in Settings. Not exported; URI permission is granted per share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Telepic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
