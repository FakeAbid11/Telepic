<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) data extraction rules — govern both cloud backup and device-to-device transfer.

  The TDLib session/database (noBackupFilesDir) and the upload staging files (cacheDir) are already
  outside the backup/transfer set by location. These rules keep the wrapped TDLib key blob (filesDir)
  and the Room database — cloud manifest, backup queue, organization flags and geotag cache, all keyed
  to this device and this Telegram session — out of both cloud backup and direct device transfer.

  Empty benign DataStore preferences (theme, onboarding completion, backup choice) stay eligible.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path=".tdlib_db_key.v1" />
        <exclude domain="database" path="telepix.db" />
        <exclude domain="database" path="telepix.db-wal" />
        <exclude domain="database" path="telepix.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path=".tdlib_db_key.v1" />
        <exclude domain="database" path="telepix.db" />
        <exclude domain="database" path="telepix.db-wal" />
        <exclude domain="database" path="telepix.db-shm" />
    </device-transfer>
</data-extraction-rules>
