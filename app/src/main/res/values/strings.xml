    <string name="photos_title">Telepix</string>
    <string name="photos_empty_title">Your photos will appear here</string>
    <string name="photos_empty_description">This is your local media timeline. Telepix will organize your photos and videos here in a fast, beautiful grid — coming in a later phase.</string>

    <!-- Cloud -->
    <string name="cloud_title">Cloud</string>
    <string name="cloud_empty_title">Telepix Cloud is not set up yet</string>
    <string name="cloud_empty_description">Cloud will show the media you back up to your private Telepix Backup channel on Telegram. Browse previews without automatically downloading originals. Telegram connection arrives in a later phase.</string>

