    <!-- Screen 1 — Welcome -->
    <string name="onboarding_welcome_tagline">A modern personal photo and video library with Telegram-powered cloud backup.</string>
    <string name="onboarding_welcome_illustration">Telepic: local photos backed up to the cloud</string>

    <!-- Screen 2 — How Telepic Works -->
    <string name="onboarding_how_title">How Telepic works</string>
    <string name="onboarding_how_local_title">Local first</string>
    <string name="onboarding_how_local_body">Your phone stays your primary photo library. Telepic organizes what is already on your device.</string>
    <string name="onboarding_how_backup_title">You choose what backs up</string>
    <string name="onboarding_how_backup_body">Telepic recognizes your media and queues backup only for what you select — nothing uploads before you decide.</string>
    <string name="onboarding_how_cloud_title">Cloud on Telegram</string>
    <string name="onboarding_how_cloud_body">Backed-up media is stored in your private Telegram channel, so you can browse it later without re-downloading originals.</string>

    <!-- Screen 3 — Permissions -->
    <string name="onboarding_permissions_title">Media permissions</string>
    <string name="onboarding_permissions_body">Telepic needs access to your photos and videos to show your local library and back up the media you choose.</string>
    <string name="onboarding_permissions_grant">Allow photo &amp; video access</string>
    <string name="onboarding_permissions_try_again">Try again</string>
    <string name="onboarding_permissions_open_settings">Open settings</string>
    <string name="onboarding_permissions_state_granted">Full access granted</string>
    <string name="onboarding_permissions_state_granted_body">Telepic can see your photos and videos.</string>
    <string name="onboarding_permissions_state_partial">Limited access</string>
    <string name="onboarding_permissions_state_partial_body">You chose specific photos. Telepic can see only those. You can change this anytime in settings.</string>
    <string name="onboarding_permissions_state_denied">Access denied</string>
    <string name="onboarding_permissions_state_denied_body">Without access, Telepic can\'t show your library. You can still continue and grant access later.</string>
    <string name="onboarding_permissions_state_blocked">Access blocked</string>
    <string name="onboarding_permissions_state_blocked_body">Android is blocking the request. Enable photo access in app settings, then continue.</string>

